########################################################################
# Le Git Config
########################################################################

[user]
  name = Matthias Kretschmann
  email = m@kretschmann.io
  signingKey = 0xDD7831FC

[commit]
  gpgSign = true

[github]
  user = kremalicious

[core]
  excludesfile = ~/.gitignore
  quotepath = false

  # Handle umlauts and such better on macOS
  #   for whatever crazy reason this explicitly
  #   has to be set to false so tracked files with
  #   special characters don't get treated as untracked
  precomposeunicode = false

  # Make `git rebase` safer on macOS
  # More info: http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/
  trustctime = false

  # Be case sensitive on case insensitive systems
  ignorecase = false

[alias]
  c  = clone --recursive
  co = checkout
  l  = log --oneline --decorate -15
  lo = log --oneline --decorate
  s  = status -s

  # Amend the currently staged files to the latest commit
  amend = commit --amend --reuse-message=HEAD

  # Remove local branches that have already been merged into main
  # a.k.a. ‘delete merged’
  dm = "!git branch --merged main --format '%(refname:short)' | grep -vx main | xargs -n 1 git branch -d"

  uncommit = reset --soft HEAD^
  unstage  = reset HEAD
  yolo     = push --force

[fetch]
  prune = true

[pull]
  rebase = true

[rebase]
  autoStash = true

[init]
  defaultBranch = main

[status]
  showUntrackedFiles = all

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

# Include macOS-specific config (credential helper, diff/merge tools)
# Silently ignored if file doesn't exist
[include]
  path = ~/.gitconfig.macos
